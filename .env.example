# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit real values.
# Every NEXT_PUBLIC_* var is shipped to the browser and is readable by anyone
# using the app — treat them as public. Everything else stays server-only.
# ---------------------------------------------------------------------------

# --- LINE Login / LIFF ------------------------------------------------------

# LIFF app ID, used by liff.init() in the browser.
# OPEN QUESTION (CLAUDE.md → Open decisions): this env var assumes ONE shared
# LIFF app across all salons. If we go with one LINE channel per salon, the
# LIFF ID becomes tenant data in the database and this var goes away.
NEXT_PUBLIC_LIFF_ID=

# LINE Login channel ID. Server-side only: this is the expected `aud` claim
# when verifying an ID token, which we do on every mutating request
# (CLAUDE.md §3). Deliberately not NEXT_PUBLIC — verification never happens
# in the browser.
LINE_CHANNEL_ID=

# LINE Login channel secret. Server-only. Needed for token exchange against
# the LINE platform; not required for `aud`/signature checks alone.
LINE_CHANNEL_SECRET=

# --- Supabase ---------------------------------------------------------------

# Project URL and anon key. Safe to expose: the anon key is constrained by
# Row Level Security, which is the actual tenant boundary (CLAUDE.md §2).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — BYPASSES ROW LEVEL SECURITY COMPLETELY.
# Migrations, seeds, and offline jobs only. Never import this into a route
# handler, server action, or component render path (CLAUDE.md §2).
SUPABASE_SERVICE_ROLE_KEY=
