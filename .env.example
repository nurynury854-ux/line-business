# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time. Two
# consequences: the value is public no matter how it is stored, and changing it
# requires a redeploy — saving it in Vercel alone changes nothing.
#
# In Vercel, NEXT_PUBLIC_* must be type "Config"; everything else is "Secret".
# That choice is one-way: a saved Secret cannot be converted, only deleted and
# recreated.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------

# Project Settings -> API -> Project URL. Looks like https://<ref>.supabase.co
# NOT the supabase.com/dashboard/... address shown in the browser bar.
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> anon / publishable key. Public by design; Row Level
# Security is what constrains it (CLAUDE.md §2).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> JWT secret. Signs the short-lived Supabase token the
# route mints after verifying a LINE ID token.
# VERIFIED against this project: HS256, with the secret used as its UTF-8 string
# (NOT base64-decoded). The other three combinations are rejected with PGRST301.
SUPABASE_JWT_SECRET=

# Bypasses Row Level Security entirely. Migrations, seeds and offline jobs only —
# never a route handler, server action, or render path (CLAUDE.md §2).
# Not required to run the app; needed only for admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE Login channel (LIFF + ID token verification) ----------------------

# There is deliberately NO env var for the LINE Login channel id.
#
# Topology is one Login channel per salon, under a Provider in that salon's
# legal name (LINE's policy for agency integrations). So the channel id is
# tenant data: it lives in tenants.line_login_channel_id and is read per
# request, keyed by the resolved tenant.
#
# A global value would be wrong for every salon but one — and worse, verifying
# an ID token against the wrong `aud` is precisely the check that stops Salon
# A's token being replayed against Salon B. Do not reintroduce one.

# LIFF app id for the DIAGNOSTICS page only (/liff/diagnostics), which is a
# single-tenant dev tool. The booking flow must read tenants.liff_id for the
# resolved tenant instead — per-salon channels mean per-salon LIFF apps.
NEXT_PUBLIC_LIFF_ID=

# LINE Login channel secret. Server-only, and NOT needed to verify an ID token's
# signature or audience — only for token exchange against the LINE platform.
# Per-salon channels mean this is tenant data too; if it is ever actually
# needed, it belongs in the tenants row (encrypted), not here.
LINE_LOGIN_CHANNEL_SECRET=

# --- LINE Messaging API channel (booking notifications) ---------------------
# A separate channel from LINE Login above. Only needed once the app sends
# messages; nothing in the booking flow requires these yet.

# Messaging API channel secret — validates inbound webhook signatures.
LINE_MESSAGING_CHANNEL_SECRET=

# Messaging API channel access token — authorises outbound pushes.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
